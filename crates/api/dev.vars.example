# Salin ke `.dev.vars` (file itu di-.gitignore). Hanya dipakai `wrangler dev`.
#
# Database lokal: jalankan `turso dev --db-file local.db --port 8081` di
# terminal lain. Port 8080 dipakai `dx serve`, 8787 dipakai `wrangler dev`.
TURSO_DATABASE_URL=http://127.0.0.1:8081
# Kosongkan untuk database lokal; isi dengan token asli hanya untuk database
# produksi/staging (`turso db tokens create <nama>`).
TURSO_AUTH_TOKEN=
# `dx serve --package web` berjalan di 8080 (127.0.0.1 dan localhost adalah
# origin yang berbeda bagi browser, daftarkan keduanya).
ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
# Guestbook (D4). Lokal boleh dikosongkan; di production isi lewat
# `npx wrangler secret put RATE_LIMIT_SALT` (string acak, `openssl rand -hex 32`).
RATE_LIMIT_SALT=
# Kata terlarang di chat, dipisah koma. Jangan taruh daftar aslinya di repo.
BANNED_WORDS=
# Endpoint admin (laporan, sembunyikan entri). Kosong = endpoint admin mati.
# Di production: `npx wrangler secret put ADMIN_TOKEN` (min. 32 karakter,
# `openssl rand -hex 32`). Lokal boleh diisi string acak panjang.
ADMIN_TOKEN=
# Cron jurnal GitHub (D5). Di production: `npx wrangler secret put GITHUB_TOKEN`
# (scope read:user cukup). Lokal: kosong boleh; isi bila mau mencoba
# `POST /api/v1/admin/journal/refresh` (butuh ADMIN_TOKEN di atas) atau
# `wrangler dev --test-scheduled` lalu `curl "http://127.0.0.1:8787/__scheduled"`.
GITHUB_TOKEN=
